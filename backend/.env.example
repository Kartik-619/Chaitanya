# ========================================
# CHAITANYA 2025 - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your actual values

# ========================================
# SMTP EMAIL CONFIGURATION (Gmail)
# ========================================
# For Gmail App Password setup:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to App Passwords
# 4. Generate password for "Mail" > "Other (Custom)"
# 5. Copy the 16-character password below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM=your-email@gmail.com

# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://your-vercel-domain.vercel.app

# ========================================
# GOOGLE SHEETS INTEGRATION (Optional)
# ========================================
# For Google Sheets API setup:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project
# 3. Enable Google Sheets API
# 4. Create Service Account credentials
# 5. Download JSON key file
# 6. Place in backend/config/google-credentials.json

GOOGLE_SHEETS_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com

# ========================================
# PAYMENT GATEWAY (Razorpay)
# ========================================
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ========================================
# ADMIN CREDENTIALS
# ========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SECRET_KEY=your-jwt-secret-key-min-32-characters

# ========================================
# OPTIONAL: SMS SERVICE (For OTP backup)
# ========================================
# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# OR MSG91 Configuration
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=your-sender-id

# ========================================
# PERFORMANCE & LIMITS
# ========================================
MAX_EMAILS_PER_DAY=90
MAX_REGISTRATIONS_PER_MINUTE=50
SESSION_TIMEOUT_MINUTES=30

# ========================================
# SECURITY
# ========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=50
ENABLE_CORS=true
ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app,http://localhost:5173

# ========================================
# LOGGING & MONITORING
# ========================================
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false
